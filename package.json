{
  "name": "@canvasflow/feed",
  "description": "This is canvasflow utility for processing feeds",
  "version": "2.0.13",
  "type": "module",
  "license": "UNLICENSED",
  "sideEffects": false,
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "@canvasflow:registry": "https://npm.pkg.github.com"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    }
  },
  "keywords": [
    "rss",
    "feed"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Canvasflow/feed.git"
  },
  "bugs": {
    "url": "https://github.com/Canvasflow/feed/issues"
  },
  "scripts": {
    "dev": "vp dev",
    "build": "vp pack",
    "test": "vp test",
    "test:debug": "vp test --test-timeout=0 --no-file-parallelism",
    "test:ui": "VP_VERSION=4.1.10 vp test watch --ui --open",
    "test:unit": "VP_VERSION=4.1.10 vp test --ui --tags-filter=unit",
    "test:integration": "VP_VERSION=4.1.10 vp test --ui --tags-filter=integration",
    "test:todo": "VP_VERSION=4.1.10 vp test --ui --tags-filter=todo",
    "test:broken": "VP_VERSION=4.1.10 vp test --ui --tags-filter=broken",
    "test:snapshot": "vp test src/**/*.snapshot.test.ts",
    "test:snapshot:update": "vp test --update src/**/*.snapshot.test.ts",
    "lint": "vp lint",
    "lint:fix": "vp lint --fix",
    "coverage": "VP_VERSION=4.1.10 vp test --coverage",
    "coverage:ui": "VP_VERSION=4.1.10 vp test watch --coverage --ui --open",
    "bench": "VP_VERSION=4.1.10 vp test bench",
    "bench:save": "VP_VERSION=4.1.10 vp test bench --outputJson bench-results.json",
    "check:publint": "publint",
    "check:attw": "attw --pack . --ignore-rules cjs-resolves-to-esm",
    "check:size": "node scripts/check-size.mjs",
    "smoke": "node scripts/smoke-consumer.mjs",
    "commit": "cz",
    "format": "vp fmt .",
    "changelog": "node scripts/update-changelog.mjs",
    "prepare": "git rev-parse --git-dir > /dev/null 2>&1 && git config core.hooksPath .vite-hooks && chmod +x .vite-hooks/* || true"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog",
      "disableScopeLowerCase": false,
      "disableSubjectLowerCase": false,
      "maxHeaderWidth": 100,
      "maxLineWidth": 100
    }
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@types/he": "^1.2.3",
    "@types/luxon": "^3.7.5",
    "@types/node": "^26.4.0",
    "@vitest/coverage-v8": "^4.1.11",
    "@vitest/ui": "^4.1.11",
    "cz-conventional-changelog": "^3.3.0",
    "publint": "^0.3.24",
    "typescript": "^7.0.2",
    "vite-plus": "^0.3.0"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "fast-xml-parser": "^5.11.1",
    "he": "^1.2.0",
    "linkedom": "^0.18.13",
    "luxon": "^3.6.1",
    "zod": "^4.5.4"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@0.3.0",
    "vitest": "4.1.11",
    "commitizen": {
      "lodash": "^4.17.22",
      "inquirer": "^9.3.7"
    },
    "tmp": "^0.2.4"
  },
  "packageManager": "npm@11.16.0",
  "allowScripts": {
    "fsevents@2.3.3": true
  }
}
