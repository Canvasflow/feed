    "link": "https://news.google.com/publications/CAAqKAgKIiJDQklTRXdnTWFnOEtEWFJ2YlhObmRXbGtaUzVqYjIwb0FBUAE",
    "warnings": [],
  },
  {
    "component": "body",
    "element": {
      "attributes": {
        "id": "elk-1487754f-5d0e-4d2e-a9c0-c374dfd625d6",
      },
      "tag": "p",
    },
    "errors": [],
