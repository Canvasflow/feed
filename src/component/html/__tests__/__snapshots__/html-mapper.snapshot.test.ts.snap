    "text": "<ul class="meganav-desktop__list"> <li> <a href="https://www.tomsguide.com" class="meganav-item__link"> </a> </li> <li> <a href="https://www.tomsguide.com/phones" class="meganav-item__link"> Phones </a> <ul class="meganav-item-list" style="--nav-item-font-weight:400;--nav-item-text-transform:none;--nav-item-line-height:2.5;--nav-item-font-size:14px"> <li> <span> Phone Insights </span> <ul class="meganav-item-list" style="--nav-item-font-weight:400;--nav-item-font-size:13px;--nav-item-line-height:1.85"> <li> <a href="https://www.tomsguide.com/phones/best-picks" class="meganav-item__link"> Phone Best Picks </a> </li> <li> <a href="https://www.tomsguide.com/phones/deals" class="meganav-item__link"> Phone Deals </a> </li> <li> <a href="https://www.tomsguide.com/phones/face-off" class="meganav-item__link"> Phone Face-Offs </a> </li> <li> <a href="https://www.tomsguide.com/phones/how-to" class="meganav-item__link"> Phone How-Tos </a> </li> <li> <a href="https://www.tomsguide.com/phones/news" class="meganav-item__link"> Phone News </a> </li> <li> <a href="https://www.tomsguide.com/phones/reviews" class="meganav-item__link"> Phone Reviews </a> </li> <li> <a href="https://www.tomsguide.com/coupons/category/phones-and-mobile-carriers" class="meganav-item__link"> Phone Coupons </a> </li> </ul> </li> <li> <a href="https://www.tomsguide.com/phones/network-carriers" class="meganav-item__title-link" style="--nav-item-font-weight:600;--nav-item-font-size:14px"> Network Carriers </a> <ul class="meganav-item-list" style="--nav-item-font-weight:400;--nav-item-font-size:13px;--nav-item-line-height:1.85"> <li> <a href="https://www.tomsguide.com/tag/atandt" class="meganav-item__link"> AT&amp;T </a> </li> <li> <a href="https://www.tomsguide.com/tag/t-mobile" class="meganav-item__link"> T-Mobile </a> </li> <li> <a href="https://www.tomsguide.com/tag/verizon" class="meganav-item__link"> Verizon </a> </li> </ul> </li> <li> <a href="https://www.tomsguide.com/phones/android-phones